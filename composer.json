{
  "name": "dockcodes/dock-ray-symfony",
  "type": "symfony-bundle",
  "description": "Symfony bundle for the DockRay PHP SDK",
  "keywords": [
    "symfony",
    "error-monitoring",
    "crash-reporting",
    "performance-monitoring"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Jacek Labudda",
      "email": "j.labudda@dock.codes",
      "homepage": "https://dock.codes"
    }
  ],
  "require": {
    "php": "^8.2",
    "dockcodes/dock-ray": "^1.4",
    "symfony/config": "^6.4|^7.0",
    "symfony/dependency-injection": "^6.4|^7.0",
    "symfony/event-dispatcher": "^6.4|^7.0",
    "symfony/http-kernel": "^6.4|^7.0",
    "symfony/console": "^6.4|^7.0"
  },
  "require-dev": {
    "symfony/security-core": "^6.4|^7.0",
    "symfony/framework-bundle": "^6.4|^7.0",
    "symfony/scheduler": "^6.4|^7.0",
    "symfony/messenger": "^6.4|^7.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Dock\\Ray\\Symfony\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "symfony/scheduler": "Automatic hourly inventory schedule (requires a running Messenger worker)",
    "symfony/messenger": "Consume the automatic DockRay inventory schedule"
  },
  "scripts": {
    "test": "phpunit"
  }
}
